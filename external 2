    static string GetLocationName(int position)
    {
        switch (position)
        {
            case 0:
                return "Well";

            case 1:
                return "Cave";

            case 2:
                return "Treasure Room";

            case 3:
                return "Fields";

            case 4:
                return "Town";

            case 5:
                return "Hut";

            case 6:
                return "Inside the Hut";

            case 7:
                return "True Treasure Room";

            case 8:
                return "Barn";

            case 9:
                return "Barn Basement";

            case 10:
                return "Warehouse";

            case 11:
                return "Tunnel";

            default:
                return "Unknown";
        }
    }



   


